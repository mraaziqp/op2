# GEMINI_API_KEY: Required for Gemini AI API calls (Phase 5).
# AI Studio automatically injects this at runtime from user secrets.
# Keep strictly server-side; never expose in client bundles.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# FIREBASE CONFIGURATION (Optional / Cloud Sync)
# Populate these variables if configuring external Firebase Firestore & Auth.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID=""
